FROM quay.io/pypa/manylinux_2_28_x86_64

RUN dnf install -y \
      autoconf automake libtool make gcc gcc-c++ \
      cmake pkgconf-pkg-config bison flex gperf gettext-devel \
      curl xz bzip2 tar patchelf \
    && dnf clean all

ENV PATH=/opt/python/cp313-cp313/bin:${PATH}
ENV UV_LINK_MODE=copy

RUN python -m pip install --no-cache-dir "uv>=0.10,<0.11"

WORKDIR /io
CMD ["bash"]
